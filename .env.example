DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=https://api.in.deepgram.com
DEEPGRAM_MODEL=nova-3

# Sarvam batch STT (codemix + diarization), the default speech provider.
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v4

# Any OpenAI-compatible endpoint. Default: Gemini free tier (synthetic data only).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
# Groq alternative (8K TPM free tier, fits calls under ~20 min):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=3
LLM_CONCURRENCY=4
TRANSLATE_BATCH_SIZE=120

# One engine per call: SPEECH_PROVIDER, or LONG_CALL_SPEECH for calls over LONG_CALL_MINUTES.
SPEECH_PROVIDER=sarvam
LONG_CALL_SPEECH=gemini
LONG_CALL_MINUTES=10
COUNSELOR_CHANNEL=0
DATA_DIR=./data
KEEP_AUDIO=false
MAX_UPLOAD_MB=200
EXPORT_WEBHOOK_URL=
LOG_LEVEL=INFO
